#!/bin/sh

repo_root="$(git rev-parse --show-toplevel)" || exit 1

# Git exports GIT_DIR and related variables to hooks. Child git commands
# inside tests then target this repository instead of their own fixture
# directories. Unset them so the preflight test suite stays isolated.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

echo "Running Halv fast preflight before push..."
node "$repo_root/scripts/preflight.mjs"
status=$?

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "Push blocked by the Halv preflight gate." >&2
  echo "Emergency bypass: git push --no-verify" >&2
fi

exit "$status"
